{
  "name": "subedei_api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/main.ts",
    "demo": "tsx --env-file-if-exists=../.env src/main.ts --memory",
    "seed": "tsx --env-file-if-exists=../.env src/seed-cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/main.js",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "schema:print": "tsx src/print-schema.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@apollo/subgraph": "^2.15.1",
    "@as-integrations/express5": "^1.1.2",
    "@trpc/client": "^11.0.0",
    "bullmq": "^5.81.5",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "graphql-tag": "^2.12.7",
    "ioredis": "^5.11.1",
    "mongoose": "^8.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "mongodb-memory-server": "^10.1.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
